# Required OAuth app credentials
STRAVA_CLIENT_ID=your_strava_app_client_id
STRAVA_CLIENT_SECRET=your_strava_app_client_secret
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

# Required app settings
ANNUAL_GOAL_KM=365
MAX_ANNUAL_GOAL_KM=100000
DATABASE_PATH=data/strava_cache.db
SYNC_PAGE_SIZE=100
SYNC_PAGE_DELAY_SECONDS=1.1
SYNC_MAX_PAGES=60
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
SUPPORT_CONTACT_EMAIL=your_support_email@example.com

# Dashboard sync behavior
AUTO_SYNC_ENABLED=true
AUTO_SYNC_STALENESS_HOURS=24
MANUAL_SYNC_COOLDOWN_SECONDS=3600

# Optional: secure token for scheduled maintenance trigger requests
MAINTENANCE_CRON_TOKEN=token_for_cron_jobs

# For GitHub scheduled maintenance, set MAINTENANCE_BASE_URL secret to the app root URL only
# (no path, no query string), for example: https://strava-goal-visualizer.onrender.com

# Required for web OAuth in deployed environments.
# On Render, auto-detected from RENDER_EXTERNAL_URL if not set explicitly.
# For local dev set to http://localhost:8501
APP_BASE_URL=https://your-app.onrender.com

# Public legal pages (for dashboard links and API review)
ABOUT_URL=https://your-org.github.io/strava-goal-visualizer/about.html
PRIVACY_POLICY_URL=https://your-org.github.io/strava-goal-visualizer/privacy.html
TERMS_URL=https://your-org.github.io/strava-goal-visualizer/terms.html
DATA_DELETION_URL=https://your-org.github.io/strava-goal-visualizer/data-deletion.html
