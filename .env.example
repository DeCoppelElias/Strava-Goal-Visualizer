# Required OAuth app credentials
STRAVA_CLIENT_ID=your_strava_app_client_id
STRAVA_CLIENT_SECRET=your_strava_app_client_secret
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

# Required app settings
ANNUAL_GOAL_KM=365
MAX_ANNUAL_GOAL_KM=100000
DATABASE_PATH=data/strava_cache.db
SYNC_PAGE_SIZE=100
SYNC_PAGE_DELAY_SECONDS=1.1
SYNC_MAX_PAGES=60
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
SUPPORT_CONTACT_EMAIL=support@example.com

# Dashboard sync behavior
AUTO_SYNC_ENABLED=true
AUTO_SYNC_STALENESS_HOURS=24
MANUAL_SYNC_COOLDOWN_SECONDS=3600

